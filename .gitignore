# NVDRS is restricted-use data: never commit data files.
*.csv
*.tsv
*.xlsx
*.xls
*.sas7bdat
*.dta
*.sav
data/
out/
tests/sample_data/

# Rules templates are configuration, not data.
!config/*.json

# The state-coverage panel is configuration too: one row per jurisdiction-year,
# no case-level information in it.
!config/*.csv

__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.DS_Store
